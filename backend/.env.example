# ==============================================================================
# Panchakarma Therapy Tracker — Local Environment Configuration Template
# Copy this file to .env before starting services: cp .env.example .env
# ==============================================================================

# Application Environment
APP_ENV=development
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# PostgreSQL 16 Infrastructure
DB_HOST=localhost
DB_PORT=5432
DB_USER=panchakarma
DB_PASSWORD=panchakarma_secret_2026
DB_NAME=identity_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINS=30
DB_CONN_MAX_IDLE_MINS=10

# Redis 7 Infrastructure
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DIAL_TIMEOUT_MS=3000
REDIS_READ_TIMEOUT_MS=2000
REDIS_WRITE_TIMEOUT_MS=2000
REDIS_POOL_SIZE=20

# Apache Kafka 3.7 Infrastructure
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=panchakarma-local
KAFKA_CONSUMER_GROUP=panchakarma-group

# Service Internal Downstream URLs (Used by API Gateway)
IDENTITY_SERVICE_URL=http://localhost:8081
CLINIC_SERVICE_URL=http://localhost:8082
APPOINTMENT_SERVICE_URL=http://localhost:8083
THERAPY_SERVICE_URL=http://localhost:8084
NOTIFICATION_SERVICE_URL=http://localhost:8085
FEEDBACK_SERVICE_URL=http://localhost:8086

# JWT Security
JWT_SECRET=panchakarma_super_secret_jwt_key_2026_dev_only
JWT_ACCESS_EXPIRY_MINS=15
JWT_REFRESH_EXPIRY_DAYS=7
