# Multi-stage Dockerfile for Identity Service
FROM golang:1.26-alpine AS builder

WORKDIR /app

# Cache dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build standalone binary
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-w -s" -o /bin/identity-service ./cmd/identity-service

# Final minimal runtime image
FROM alpine:3.19

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app
COPY --from=builder /bin/identity-service /app/identity-service
COPY migrations/identity /app/migrations/identity

EXPOSE 8081 9081

ENTRYPOINT ["/app/identity-service"]
